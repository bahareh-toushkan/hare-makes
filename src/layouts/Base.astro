---
import '@fontsource/black-han-sans/index.css';
import 'pretendard/dist/web/variable/pretendardvariable-dynamic-subset.css';
import '../styles/global.css';
import Mark from '../components/Mark.astro';
import site from '../data/site.json';
import { UI, href, asset, absolute, type Lang } from '../lib/i18n';
import { inkFor } from '../lib/color';

interface Props {
  lang: Lang;
  path: string;            // 언어와 무관한 경로: '/', '/works/x/', '/about/'
  title: string;
  description: string;
  ogImage?: string;        // public/ 기준 경로. 없으면 og-default.png
  ogType?: 'website' | 'video.other' | 'profile';
  jsonLd?: Record<string, unknown>;
  noindex?: boolean;
  accent?: string;         // 작품 색: 이 페이지의 로고·포인트 색을 덮어씀 (배경은 그대로 검정)
  tone?: 'quiet';          // 차분한 작품: 제목 서체를 본문 서체로
}
const { lang, path, title, description, ogImage = 'og-default.png', ogType = 'website', jsonLd, noindex = false, accent, tone } = Astro.props;
const bodyStyle = accent ? `--accent:${accent};--accent-ink:${inkFor(accent)}` : undefined;   // 작품 색과 그 위 글자색
const t = UI[lang];
const other: Lang = lang === 'ko' ? 'en' : 'ko';
const siteURL = Astro.site;
const canonical = absolute(href(lang, path), siteURL);
const alt = { ko: absolute(href('ko', path), siteURL), en: absolute(href('en', path), siteURL) };
const ogAbs = absolute(asset(ogImage), siteURL);
const fullTitle = path === '/' ? title : `${title} — ${site.handle}`;
const current = (p: string) => (path === p || (p !== '/' && path.startsWith(p)) ? 'page' : undefined);
const nav = [
  { p: '/', label: t.works },
  { p: '/about/', label: t.about },
  { p: '/contact/', label: t.contact }
];
---
<!doctype html>
<html lang={lang}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  {noindex && <meta name="robots" content="noindex" />}
  <link rel="canonical" href={canonical} />
  <link rel="alternate" hreflang="ko" href={alt.ko} />
  <link rel="alternate" hreflang="en" href={alt.en} />
  <link rel="alternate" hreflang="x-default" href={alt.ko} />
  <meta name="theme-color" content="#0b0b0c" />
  <meta name="color-scheme" content="dark" />
  <link rel="icon" href={asset('favicon.svg')} type="image/svg+xml" />
  <link rel="icon" href={asset('favicon-32.png')} sizes="32x32" type="image/png" />
  <link rel="apple-touch-icon" href={asset('apple-touch-icon.png')} />
  <meta property="og:site_name" content={site.handle} />
  <meta property="og:type" content={ogType} />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogAbs} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:locale" content={lang === 'ko' ? 'ko_KR' : 'en_US'} />
  <meta property="og:locale:alternate" content={lang === 'ko' ? 'en_US' : 'ko_KR'} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={fullTitle} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogAbs} />
  {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
</head>
<body style={bodyStyle} class={tone === 'quiet' ? 'tone-quiet' : undefined}>
  <a class="skip" href="#main">{t.skip}</a>
  <header class="site-header">
    <a class="brand" href={href(lang, '/')} aria-label={`${site.handle} — ${t.works}`}>
      <Mark />
      <span>{site.handle}</span>
    </a>
    <nav aria-label={t.nav}>
      <ul>
        {nav.map(n => <li><a href={href(lang, n.p)} aria-current={current(n.p)}>{n.label}</a></li>)}
        <li class="lang">
          <a href={href(other, path)} hreflang={t.otherLangCode} lang={t.otherLangCode} aria-label={`${t.langLabel}: ${t.otherLang}`}>{t.otherLang}</a>
        </li>
      </ul>
    </nav>
  </header>
  <main id="main" tabindex="-1">
    <slot />
  </main>
  <footer class="site-footer">
    <p>© 2026 {site.name.ko} · {site.name.en}</p>
    <p class="links">
      <a href={site.instagram} rel="me">Instagram</a>
      <a href={site.github} rel="me">GitHub</a>
      <a href={`mailto:${site.email}`}>{site.email}</a>
    </p>
  </footer>
</body>
</html>
