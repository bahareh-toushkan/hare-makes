---
// GitHub Pages는 없는 주소에 이 페이지(404.html)를 보여 준다. 두 언어를 함께 표시
import Base from '../layouts/Base.astro';
import { UI, href } from '../lib/i18n';
---
<Base lang="ko" path="/404/" title={`404 — ${UI.ko.notFound}`} description={UI.ko.notFoundLead} noindex>
  <header class="page-head">
    <h1>404</h1>
    <p>{UI.ko.notFound}. {UI.ko.notFoundLead}</p>
    <p lang="en">{UI.en.notFound}. {UI.en.notFoundLead}</p>
  </header>
  <p><a class="external" href={href('ko', '/')}>{UI.ko.home}</a></p>
</Base>
